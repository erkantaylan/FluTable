@typeparam TItem
@namespace AppGrid.Components

@* Register column definitions (they render nothing themselves) *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="ag-wrapper" style="@WrapperStyle">

    @* ── Toolbar ─────────────────────────────────────────────── *@
    <div class="ag-toolbar">
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size16.Add())"
                      OnClick="HandleAddRow">
            Add Row
        </FluentButton>

        @if (HasSelection)
        {
            <FluentButton Appearance="Appearance.Outline"
                          IconStart="@(new Icons.Regular.Size16.Delete())"
                          OnClick="HandleDeleteSelected">
                Delete Selected
            </FluentButton>
        }

        <FluentCheckbox @bind-Value="ShowRowActions" Label="Edit rows" />

        <div class="ag-settings">
            <label class="ag-setting">
                <span>Font</span>
                <input type="number" class="ag-setting-input" @bind="_fontSize" min="8" max="32" />
            </label>
            <label class="ag-setting">
                <span>Padding</span>
                <input type="number" class="ag-setting-input" @bind="_cellPadding" min="0" max="20" />
            </label>
            <label class="ag-setting">
                <span>Margin</span>
                <input type="number" class="ag-setting-input" @bind="_outerMargin" min="0" max="60" />
            </label>
        </div>
    </div>

    @* ── Table ───────────────────────────────────────────────── *@
    <div class="ag-scroll">
        <table id="@_tableId" data-ag-table class="ag-table">

            <colgroup>
                @foreach (var col in _columns)
                {
                    <col id="@col.ColId"
                         class="@(col.IsFixed ? "ag-col-fixed" : "ag-col-flex")"
                         style="@(col.Width is not null ? $"width:{col.Width}" : "")" />
                }
                @if (ShowRowActions)
                {
                    <col class="ag-col-fixed" style="width:96px" />
                }
            </colgroup>

            <thead>
                <tr class="ag-header-row">
                    @{
                        var lastFlexIdx = _columns.FindLastIndex(c => !c.IsFixed);
                    }
                    @for (var ci = 0; ci < _columns.Count; ci++)
                    {
                        var col = _columns[ci];
                        var showHandle = !col.IsFixed && ci != lastFlexIdx;
                        <th class="ag-th @(col.IsFixed ? "ag-th-fixed" : "ag-th-resizable")">
                            <span class="ag-th-label">
                                @if (col.HeaderTemplate is not null)
                                {
                                    @col.HeaderTemplate
                                }
                                else
                                {
                                    @col.Header
                                }
                            </span>
                            @if (showHandle)
                            {
                                <div class="ag-resize-handle"></div>
                            }
                        </th>
                    }
                    @if (ShowRowActions)
                    {
                        <th class="ag-th ag-th-fixed ag-th-actions"></th>
                    }
                </tr>
            </thead>

            <tbody>
                @for (var i = 0; i < Items.Count; i++)
                {
                    var item     = Items[i];
                    var rowIndex = i;

                    <tr class="ag-row">
                        @foreach (var col in _columns)
                        {
                            <td class="ag-td @(col.Multiline ? "ag-multiline" : "")">
                                @col.GetCellFor(item)
                            </td>
                        }
                        @if (ShowRowActions)
                        {
                            <td class="ag-td ag-td-actions">
                                <div class="ag-row-actions">
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="Insert row above"
                                                  IconStart="@(new Icons.Regular.Size16.ArrowUp())"
                                                  OnClick="@(() => HandleInsertAbove(rowIndex))" />
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="Insert row below"
                                                  IconStart="@(new Icons.Regular.Size16.ArrowDown())"
                                                  OnClick="@(() => HandleInsertBelow(rowIndex))" />
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="Delete row"
                                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                                  OnClick="@(() => HandleDeleteRow(rowIndex))" />
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
