@typeparam TItem
@namespace FluTable.Components

@* Register column definitions (they render nothing themselves) *@
<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="ag-wrapper">
    <div class="ag-scroll">
        <table id="@_tableId" data-ag-table class="ag-table">

            <colgroup>
                @foreach (var col in _columns)
                {
                    <col id="@col.ColId"
                         class="@(col.IsFixed ? "ag-col-fixed" : "ag-col-flex")"
                         style="@(col.Width is not null ? $"width:{col.Width}" : "")" />
                }
                @if (ShowRowActions)
                {
                    <col class="ag-col-fixed" style="width:96px" />
                }
            </colgroup>

            <thead>
                <tr class="ag-header-row">
                    @{
                        var lastFlexIdx = _columns.FindLastIndex(c => !c.IsFixed);
                    }
                    @for (var ci = 0; ci < _columns.Count; ci++)
                    {
                        var col = _columns[ci];
                        var showHandle = !col.IsFixed && ci != lastFlexIdx;
                        var sortable   = col.Sortable;
                        var isSorted   = sortable && _sortCol == col;
                        var sortGlyph  = isSorted ? (_sortAsc ? "▲" : "▼") : "";
                        <th class="ag-th @(col.IsFixed ? "ag-th-fixed" : "ag-th-resizable") @(sortable ? "ag-th-sortable" : "")"
                            aria-sort="@SortAria(col)"
                            @onclick="@(() => HandleHeaderClick(col))">
                            <span class="ag-th-label">
                                @if (col.HeaderTemplate is not null)
                                {
                                    @col.HeaderTemplate
                                }
                                else
                                {
                                    @col.Header
                                }
                                @if (sortable)
                                {
                                    <span class="ag-sort-indicator">@sortGlyph</span>
                                }
                            </span>
                            @if (showHandle)
                            {
                                <div class="ag-resize-handle" @onclick:stopPropagation="true"></div>
                            }
                        </th>
                    }
                    @if (ShowRowActions)
                    {
                        <th class="ag-th ag-th-fixed ag-th-actions"></th>
                    }
                </tr>
            </thead>

            <tbody>
                @{
                    var display = GetDisplayItems();
                }
                @if (display.Count == 0 && EmptyContent is not null)
                {
                    <tr class="ag-row ag-row-empty">
                        <td class="ag-td ag-td-empty" colspan="@(_columns.Count + (ShowRowActions ? 1 : 0))">
                            @EmptyContent
                        </td>
                    </tr>
                }
                else
                {
                    @for (var i = 0; i < display.Count; i++)
                    {
                        var item       = display[i];
                        var sourceIdx  = _sortCol is null ? i : Items.IndexOf(item);

                        <tr class="ag-row">
                            @foreach (var col in _columns)
                            {
                                <td class="ag-td @(col.Multiline ? "ag-multiline" : "") @(col.OverflowTooltip ? "ag-overflow-tip" : "")"
                                    data-overflow-tip="@(col.OverflowTooltip ? "1" : null)">
                                    @col.GetCellFor(item)
                                </td>
                            }
                            @if (ShowRowActions)
                            {
                                <td class="ag-td ag-td-actions">
                                    <div class="ag-row-actions">
                                        <button type="button" class="ag-btn-icon" title="Insert row above"
                                                @onclick="@(() => HandleInsertAbove(sourceIdx))">@IconArrowUp</button>
                                        <button type="button" class="ag-btn-icon" title="Insert row below"
                                                @onclick="@(() => HandleInsertBelow(sourceIdx))">@IconArrowDown</button>
                                        <button type="button" class="ag-btn-icon" title="Delete row"
                                                @onclick="@(() => HandleDeleteRow(sourceIdx))">@IconDelete</button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>
